FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# GCP VM: use localhost (matches leadpilot@localhost MySQL user).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=leadpilot
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=crypto_signals

# Optional full URL (password must be URL-encoded, e.g. @ as %40)
# DATABASE_URL=mysql+pymysql://leadpilot:LeadPilot%40GCP2026@localhost:3306/crypto_signals

TIMEZONE=UTC
SCANNER_INTERVAL_SECONDS=60
DEFAULT_TIMEFRAME=1H
EXCHANGE=kraken
LOG_LEVEL=INFO
DEBUG_MODE=false
ENABLE_SCHEDULER=true

# Firebase browser push (see docs/FIREBASE.md)
ENABLE_PUSH_ALERTS=true
ENABLE_EMAIL_ALERTS=false
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-adminsdk.json
# Or single-line JSON: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# API_KEY=your-long-random-api-key
