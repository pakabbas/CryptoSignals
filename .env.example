FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# GCP VM: use localhost (matches leadpilot@localhost MySQL user).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=leadpilot
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=crypto_signals

# Optional full URL overrides individual MYSQL_* vars
# DATABASE_URL=mysql+pymysql://leadpilot:password@127.0.0.1:3306/crypto_signals

TIMEZONE=UTC
SCANNER_INTERVAL_SECONDS=60
DEFAULT_TIMEFRAME=1H
EXCHANGE=binance
LOG_LEVEL=INFO
DEBUG_MODE=false
ENABLE_SCHEDULER=false
